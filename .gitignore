# dense benchmarks: regenerable per-article caches inside benchmarks/<root>/articles/<ID>/ (see
# benchmarks/dense500/store.py CACHE_KINDS; rebuilt by acquire.py, schema_targets.py, *_review.py --draft,
# supplement_assets.py). Everything else in articles/<ID>/ is tracked.
benchmarks/dense*/articles/*/source.txt
benchmarks/dense*/articles/*/raw.xml
benchmarks/dense*/articles/*/*.draft.json
benchmarks/dense*/articles/*/supplements/*.draft.json
benchmarks/dense*/articles/*/supplements/*.archive_members.json
