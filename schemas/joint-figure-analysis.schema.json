{
  "$defs": {
    "Chart": {
      "additionalProperties": false,
      "properties": {
        "chart_type": {
          "enum": [
            "line",
            "scatter",
            "bar",
            "histogram",
            "box",
            "violin",
            "pie",
            "heatmap",
            "area",
            "kaplan_meier",
            "forest",
            "roc",
            "waveform",
            "clinical_timeline",
            "table",
            "flowchart",
            "other",
            "unknown"
          ],
          "title": "Chart Type",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "scope": {
          "enum": [
            "individual",
            "multiple_individuals",
            "aggregate",
            "background",
            "unknown"
          ],
          "title": "Scope",
          "type": "string"
        },
        "is_clinical_chart": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Is Clinical Chart"
        },
        "x_axis": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartAxis"
            },
            {
              "type": "null"
            }
          ]
        },
        "y_axis": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartAxis"
            },
            {
              "type": "null"
            }
          ]
        },
        "measured_quantities": {
          "items": {
            "$ref": "#/$defs/VisualTag"
          },
          "title": "Measured Quantities",
          "type": "array"
        },
        "readings": {
          "items": {
            "$ref": "#/$defs/ChartReading"
          },
          "title": "Readings",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "chart_type",
        "title",
        "scope",
        "is_clinical_chart",
        "x_axis",
        "y_axis",
        "measured_quantities",
        "readings",
        "limitations"
      ],
      "title": "Chart",
      "type": "object"
    },
    "ChartAxis": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "scale": {
          "enum": [
            "linear",
            "logarithmic",
            "categorical",
            "time",
            "unknown"
          ],
          "title": "Scale",
          "type": "string"
        },
        "visible_ticks": {
          "items": {
            "type": "string"
          },
          "title": "Visible Ticks",
          "type": "array"
        }
      },
      "required": [
        "label",
        "unit",
        "scale",
        "visible_ticks"
      ],
      "title": "ChartAxis",
      "type": "object"
    },
    "ChartReading": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "pixels",
            "caption",
            "article"
          ],
          "title": "Basis",
          "type": "string"
        },
        "visual_cue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Visual Cue"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Evidence",
          "type": "array"
        },
        "certainty": {
          "enum": [
            "clear",
            "uncertain",
            "unreadable"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "metric_name": {
          "title": "Metric Name",
          "type": "string"
        },
        "metric_kind": {
          "enum": [
            "blood_pressure_systolic",
            "blood_pressure_diastolic",
            "blood_pressure_unspecified",
            "heart_rate",
            "respiratory_rate",
            "temperature",
            "oxygen_saturation",
            "ecg",
            "eeg",
            "laboratory",
            "drug_dose",
            "fluid_balance",
            "survival",
            "image_count",
            "percentage",
            "other",
            "unknown"
          ],
          "title": "Metric Kind",
          "type": "string"
        },
        "series_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Series Label"
        },
        "time_or_x_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time Or X Label"
        },
        "value_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Text"
        },
        "numeric_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Numeric Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "precision": {
          "enum": [
            "printed_exact",
            "estimated_from_plot",
            "unreadable"
          ],
          "title": "Precision",
          "type": "string"
        }
      },
      "required": [
        "basis",
        "visual_cue",
        "evidence",
        "certainty",
        "metric_name",
        "metric_kind",
        "series_label",
        "time_or_x_label",
        "value_text",
        "numeric_value",
        "unit",
        "precision"
      ],
      "title": "ChartReading",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 1600,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ClinicalSignificance": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "pixels",
            "caption",
            "article"
          ],
          "title": "Basis",
          "type": "string"
        },
        "visual_cue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Visual Cue"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Evidence",
          "type": "array"
        },
        "certainty": {
          "enum": [
            "clear",
            "uncertain",
            "unreadable"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "role": {
          "enum": [
            "diagnostic_evidence",
            "differential_diagnosis",
            "treatment_planning",
            "treatment_response",
            "disease_course",
            "prognosis",
            "procedure_documentation",
            "background",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        },
        "clinical_fact_status": {
          "const": "unreviewed_annotation",
          "default": "unreviewed_annotation",
          "title": "Clinical Fact Status",
          "type": "string"
        }
      },
      "required": [
        "basis",
        "visual_cue",
        "evidence",
        "certainty",
        "statement",
        "role"
      ],
      "title": "ClinicalSignificance",
      "type": "object"
    },
    "FigureReview": {
      "additionalProperties": false,
      "properties": {
        "figure_id": {
          "title": "Figure Id",
          "type": "string"
        },
        "assignments": {
          "items": {
            "$ref": "#/$defs/PanelAssignment"
          },
          "minItems": 1,
          "title": "Assignments",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "figure_id",
        "assignments",
        "limitations"
      ],
      "title": "FigureReview",
      "type": "object"
    },
    "FigureVisuals": {
      "additionalProperties": false,
      "properties": {
        "figure_id": {
          "title": "Figure Id",
          "type": "string"
        },
        "general_description": {
          "title": "General Description",
          "type": "string"
        },
        "detailed_description": {
          "title": "Detailed Description",
          "type": "string"
        },
        "panels": {
          "items": {
            "$ref": "#/$defs/VisualPanel"
          },
          "minItems": 1,
          "title": "Panels",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "figure_id",
        "general_description",
        "detailed_description",
        "panels",
        "limitations"
