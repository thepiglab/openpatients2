{
  "$defs": {
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "description": "Versioned article AND representation, e.g. PMC123.1:jats",
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "segment_id": {
          "minLength": 1,
          "title": "Segment Id",
          "type": "string"
        },
        "segment_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Segment Sha256",
          "type": "string"
        },
        "start": {
          "description": "Unicode code points in the immutable segment, inclusive",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "Exclusive end, never byte offsets",
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "segment_id",
        "segment_sha256",
        "start",
        "end",
        "quote"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "unit_id": {
      "minLength": 1,
      "title": "Unit Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "paragraph",
        "table_row",
        "table_cell",
        "caption",
        "figure_panel",
        "supplement_manifest"
      ],
      "title": "Kind",
      "type": "string"
    },
    "source_span": {
      "$ref": "#/$defs/SourceSpan"
    },
    "record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Record Ids",
      "type": "array"
    },
    "disposition": {
      "enum": [
        "extracted",
        "no_relevant_fact",
        "other_patient",
        "background",
        "aggregate",
        "external_case",
        "duplicate",
        "unresolved",
        "not_inspected"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "fact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Fact Ids",
      "type": "array"
    },
    "duplicate_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Duplicate Of"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "unit_id",
    "kind",
    "source_span",
    "record_ids",
    "disposition",
    "fact_ids",
    "duplicate_of",
    "rationale"
  ],
  "title": "CoverageUnit",
  "type": "object"
}
