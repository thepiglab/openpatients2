{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "description": "Exact contiguous source text; include qualifiers and negation.",
          "maxLength": 1200,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "source_section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Heading actually present in the source, otherwise null.",
          "title": "Source Section"
        }
      },
      "required": [
        "quote",
        "source_section"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "SocialExposure": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "enum": [
            "index_patient",
            "family_member",
            "mother",
            "fetus",
            "newborn",
            "other",
            "unknown"
          ],
          "title": "Subject",
          "type": "string"
        },
        "assertion": {
          "description": "Whether this fact is explicitly affirmed, negated, or uncertain; not test positivity.",
          "enum": [
            "present",
            "absent",
            "possible",
            "conditional",
            "unknown"
          ],
          "title": "Assertion",
          "type": "string"
        },
        "temporality": {
          "enum": [
            "current",
            "historical",
            "future",
            "unknown"
          ],
          "title": "Temporality",
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/TimeMention"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "domain": {
          "enum": [
            "tobacco",
            "alcohol",
            "substance",
            "occupation",
            "environment",
            "housing",
            "food_security",
            "social_support",
            "exercise",
            "diet",
            "travel",
            "sexual_history",
            "access_to_care",
            "other"
          ],
          "title": "Domain",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "current",
            "former",
            "never",
            "passive",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "amount_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount Text"
        },
        "frequency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Frequency"
        },
        "duration_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Text"
        },
        "pack_years": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only when explicitly reported, never calculated by the model.",
          "title": "Pack Years"
        }
      },
      "required": [
        "subject",
        "assertion",
        "temporality",
        "time",
        "evidence",
        "domain",
        "name",
        "status",
        "amount_text",
        "frequency",
        "duration_text",
        "pack_years"
      ],
      "title": "SocialExposure",
      "type": "object"
    },
    "TimeMention": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Verbatim temporal expression. Never invent dates or durations.",
          "title": "Text"
        },
        "relation": {
          "enum": [
            "at",
            "before",
            "after",
            "during",
            "since",
            "until",
            "unknown"
          ],
          "title": "Relation",
          "type": "string"
        },
        "anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit anchor such as surgery or admission; not publication date.",
          "title": "Anchor"
        },
        "date_iso": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "YYYY-MM-DD only if explicitly present as an unshifted full date; otherwise null.",
          "title": "Date Iso"
        }
      },
      "required": [
        "text",
        "relation",
        "anchor",
        "date_iso"
      ],
      "title": "TimeMention",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "description": "complete means this task reviewed the supplied source, NOT that the patient's history is complete.",
      "enum": [
        "complete",
        "limited",
        "not_applicable"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "documentation_status": {
      "description": "documented includes positive, negative, possible and historical facts. Silence is not_documented, never a clinical negative.",
      "enum": [
        "documented",
        "not_documented",
        "explicitly_unknown",
        "not_applicable"
      ],
      "title": "Documentation Status",
      "type": "string"
    },
    "documentation_evidence": {
      "description": "Exact source support for explicitly_unknown/not_applicable; empty for not_documented. Fact evidence stays on each item.",
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Documentation Evidence",
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SocialExposure"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "coverage",
    "limitations",
    "documentation_status",
    "documentation_evidence",
    "items"
  ],
  "title": "SocialExposures",
  "type": "object"
}
