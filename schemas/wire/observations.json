{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        },
        "source_section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "quote",
        "source_section"
      ],
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "enum": [
            "index_patient",
            "family_member",
            "mother",
            "fetus",
            "newborn",
            "other",
            "unknown"
          ],
          "type": "string"
        },
        "assertion": {
          "enum": [
            "present",
            "absent",
            "possible",
            "conditional",
            "unknown"
          ],
          "type": "string"
        },
        "temporality": {
          "enum": [
            "current",
            "historical",
            "future",
            "unknown"
          ],
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/TimeMention"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "type": "array"
        },
        "result_absent_reason": {
          "anyOf": [
            {
              "enum": [
                "pending",
                "not_performed",
                "not_reported",
                "not_applicable",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "laboratory",
            "vital",
            "imaging",
            "pathology",
            "microbiology",
            "physiologic",
            "other"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "resulted",
            "ordered",
            "planned",
            "pending",
            "not_performed",
            "historical",
            "unknown"
          ],
          "type": "string"
        },
        "text_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "numeric_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparator": {
          "enum": [
            "=",
            "<",
            "<=",
            ">",
            ">=",
            "unknown"
          ],
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "flag": {
          "enum": [
            "normal",
            "high",
            "low",
            "positive",
            "negative",
            "indeterminate",
            "unknown"
          ],
          "type": "string"
        },
        "reference_range_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "specimen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_site": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "subject",
        "assertion",
        "temporality",
        "time",
        "evidence",
        "result_absent_reason",
        "name",
        "kind",
        "status",
        "text_value",
        "numeric_value",
        "comparator",
        "unit",
        "flag",
        "reference_range_text",
        "specimen",
        "method",
        "body_site"
      ],
      "type": "object"
    },
    "TimeMention": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "relation": {
          "enum": [
            "at",
            "before",
            "after",
            "during",
            "since",
            "until",
            "unknown"
          ],
          "type": "string"
        },
        "anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_iso": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "text",
        "relation",
        "anchor",
        "date_iso"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "enum": [
        "complete",
        "limited",
        "not_applicable"
      ],
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "documentation_status": {
      "enum": [
        "documented",
        "not_documented",
        "explicitly_unknown",
        "not_applicable"
      ],
      "type": "string"
    },
    "documentation_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "type": "array"
    }
  },
  "required": [
    "coverage",
    "limitations",
    "documentation_status",
    "documentation_evidence",
    "items"
  ],
  "type": "object"
}
