{
  "$defs": {
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "enum": [
            "index_patient",
            "family_member",
            "mother",
            "fetus",
            "newborn",
            "other",
            "unknown"
          ],
          "type": "string"
        },
        "assertion": {
          "enum": [
            "present",
            "absent",
            "possible",
            "conditional",
            "unknown"
          ],
          "type": "string"
        },
        "temporality": {
          "enum": [
            "current",
            "historical",
            "future",
            "unknown"
          ],
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/TimeMention"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "type": "array"
        },
        "verification_status": {
          "enum": [
            "confirmed",
            "provisional",
            "differential",
            "refuted",
            "unconfirmed",
            "unknown"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "clinical_status": {
          "enum": [
            "active",
            "resolved",
            "remission",
            "recurrence",
            "inactive",
            "unknown"
          ],
          "type": "string"
        },
        "role": {
          "enum": [
            "primary_diagnosis",
            "comorbidity",
            "complication",
            "history",
            "differential",
            "unknown"
          ],
          "type": "string"
        },
        "body_site": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "laterality": {
          "enum": [
            "left",
            "right",
            "bilateral",
            "midline",
            "unknown"
          ],
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "subject",
        "assertion",
        "temporality",
        "time",
        "evidence",
        "verification_status",
        "name",
        "clinical_status",
        "role",
        "body_site",
        "laterality",
        "severity",
        "diagnostic_basis"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        },
        "source_section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "quote",
        "source_section"
      ],
      "type": "object"
    },
    "TimeMention": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "relation": {
          "enum": [
            "at",
            "before",
            "after",
            "during",
            "since",
            "until",
            "unknown"
          ],
          "type": "string"
        },
        "anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_iso": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "text",
        "relation",
        "anchor",
        "date_iso"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "enum": [
        "complete",
        "limited",
        "not_applicable"
      ],
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "documentation_status": {
      "enum": [
        "documented",
        "not_documented",
        "explicitly_unknown",
        "not_applicable"
      ],
      "type": "string"
    },
    "documentation_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/Condition"
      },
      "type": "array"
    }
  },
  "required": [
    "coverage",
    "limitations",
    "documentation_status",
    "documentation_evidence",
    "items"
  ],
  "type": "object"
}
