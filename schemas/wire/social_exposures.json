{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        },
        "source_section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "quote",
        "source_section"
      ],
      "type": "object"
    },
    "SocialExposure": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "enum": [
            "index_patient",
            "family_member",
            "mother",
            "fetus",
            "newborn",
            "other",
            "unknown"
          ],
          "type": "string"
        },
        "assertion": {
          "enum": [
            "present",
            "absent",
            "possible",
            "conditional",
            "unknown"
          ],
          "type": "string"
        },
        "temporality": {
          "enum": [
            "current",
            "historical",
            "future",
            "unknown"
          ],
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/TimeMention"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "type": "array"
        },
        "domain": {
          "enum": [
            "tobacco",
            "alcohol",
            "substance",
            "occupation",
            "environment",
            "housing",
            "food_security",
            "social_support",
            "exercise",
            "diet",
            "travel",
            "sexual_history",
            "access_to_care",
            "other"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "current",
            "former",
            "never",
            "passive",
            "unknown"
          ],
          "type": "string"
        },
        "amount_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "frequency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pack_years": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "subject",
        "assertion",
        "temporality",
        "time",
        "evidence",
        "domain",
        "name",
        "status",
        "amount_text",
        "frequency",
        "duration_text",
        "pack_years"
      ],
      "type": "object"
    },
    "TimeMention": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "relation": {
          "enum": [
            "at",
            "before",
            "after",
            "during",
            "since",
            "until",
            "unknown"
          ],
          "type": "string"
        },
        "anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_iso": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "text",
        "relation",
        "anchor",
        "date_iso"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "enum": [
        "complete",
        "limited",
        "not_applicable"
      ],
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "documentation_status": {
      "enum": [
        "documented",
        "not_documented",
        "explicitly_unknown",
        "not_applicable"
      ],
      "type": "string"
    },
    "documentation_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SocialExposure"
      },
      "type": "array"
    }
  },
  "required": [
    "coverage",
    "limitations",
    "documentation_status",
    "documentation_evidence",
    "items"
  ],
  "type": "object"
}
