{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        },
        "source_section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "quote",
        "source_section"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "enum": [
        "complete",
        "limited",
        "not_applicable"
      ],
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "documentation_status": {
      "enum": [
        "documented",
        "not_documented",
        "explicitly_unknown",
        "not_applicable"
      ],
      "type": "string"
    },
    "documentation_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "type": "array"
    },
    "case_kind": {
      "enum": [
        "clinical_case",
        "clinical_record",
        "exam_vignette",
        "synthetic_vignette",
        "cadaveric_anatomic",
        "animal",
        "in_vitro",
        "review_without_case",
        "multi_patient",
        "unknown"
      ],
      "type": "string"
    },
    "index_subject_description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "species": {
      "enum": [
        "human",
        "nonhuman",
        "unknown"
      ],
      "type": "string"
    },
    "multiple_index_patients": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_state": {
      "enum": [
        "living_at_presentation",
        "deceased_during_course",
        "cadaver",
        "unknown"
      ],
      "type": "string"
    },
    "care_setting": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "chief_complaint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "type": "array"
    }
  },
  "required": [
    "coverage",
    "limitations",
    "documentation_status",
    "documentation_evidence",
    "case_kind",
    "index_subject_description",
    "species",
    "multiple_index_patients",
    "subject_state",
    "care_setting",
    "chief_complaint",
    "evidence"
  ],
  "type": "object"
}
