# Copy to .env on HiPerGator, then chmod 600 .env. Never commit the real key.
# Read token from the Hugging Face account approved for gated models.
# Export this file before launching: set -a; source .env; set +a
HF_TOKEN=

WANDB_API_KEY=
WANDB_PROJECT=openpatients2-lora
# Your W&B username or team; optional when your account has a default entity.
WANDB_ENTITY=
# auto: online with a key, otherwise offline. Also accepts online/offline/disabled.
WANDB_MODE=auto
