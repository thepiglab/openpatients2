   "raw_text": "Whole-body ^(18)F-FDG PET/CT scan"
  },
  {
   "cell_id": "b00019-c1",
   "origin": "article_table",
   "role": "value",
   "segment_id": "b00019",
   "table_id": "Tab1",
   "grid_row": "data",
   "column_index": 1,
