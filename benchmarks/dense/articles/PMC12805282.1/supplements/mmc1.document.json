   "units": [
    {
     "unit": 1,
     "kind": "paragraph",
     "table": null,
     "row": null,
     "text": "Supplemental video. Fluoroscopic assessment of diaphragmatic motion and ventilation during PFA in Case 3",
     "cells": null
    },
    {
     "unit": 2,
     "kind": "paragraph",
     "table": null,
     "row": null,
     "text": "Sequential fluoroscopic clips demonstrate changes in diaphragmatic motion and ventilation during LIPV PFA:",
     "cells": null
    },
    {
     "unit": 3,
     "kind": "paragraph",
     "table": null,
     "row": null,
     "text": "Before PFA: Normal diaphragmatic excursion is observed during mechanical ventilation.",
     "cells": null
    },
    {
     "unit": 4,
     "kind": "paragraph",
     "table": null,
     "row": null,
     "text": "During initial PFA: Coughing is induced, resulting in sustained diaphragmatic elevation.",
     "cells": null
    },
    {
     "unit": 5,
     "kind": "paragraph",
     "table": null,
     "row": null,
     "text": "Post-PFA delivery: Diaphragmatic motion is minimal due to impaired mechanical ventilation.",
     "cells": null
    },
    {
     "unit": 6,
     "kind": "paragraph",
     "table": null,
     "row": null,
     "text": "Two minutes post-PFA: Manual ventilation gradually restores airflow, and diaphragmatic motion reappears.",
     "cells": null
    },
    {
     "unit": 7,
     "kind": "paragraph",
     "table": null,
     "row": null,
     "text": "Three minutes post-PFA: Ventilation and diaphragmatic motion return to baseline.",
     "cells": null
    },
    {
     "unit": 8,
     "kind": "paragraph",
     "table": null,
     "row": null,
     "text": "LIPV, left inferior pulmonary vein; PFA, pulsed field ablation.",
     "cells": null
    }
   ],
